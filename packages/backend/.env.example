# ---- processes / ports ----
# Default 127.0.0.1 keeps CP/DP local-only.
# Docker compose overrides HOST to 0.0.0.0 inside the container network.
HOST=127.0.0.1
CP_PORT=8080
DP_PORT=8081
CORS_ORIGINS=http://vibebiz-dev.com:5173,http://vibebiz-dev-ops.com:5174
DEBUG=true

# ---- observability ----
LOG_LEVEL=info
# 日志目录；留空只输出 stdout。容器内使用 /app/logs
LOG_DIR=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=vibebiz
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=

# ---- resources ----
MYSQL_HOST=127.0.0.1:3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=vibebiz
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10

REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- sandbox registry ----
SANDBOX_REGISTRY_TOKEN=change-me
SANDBOX_HEARTBEAT_TTL=15s
SANDBOX_HEALTH_INTERVAL=10s
SANDBOX_HEALTH_TIMEOUT=2s
ASYNQ_REDIS_DB=1
ASYNQ_CONCURRENCY=4

# ---- auth / session ----
COOKIE_SECURE=false
SESSION_USER_TTL=168h
SESSION_OPS_TTL=12h

S3_BUCKET=vibebiz
S3_REGION=default
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 当前桶内的统一前缀，例如 tmp/vibebiz/
S3_REMOTE_DIR_PREFIX=
# MinIO 本地一般 true；阿里云 OSS 一般 false
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_MINUTES=15
# 企业工程开发 Harness zip 的完整 S3 key（不拼接 S3_REMOTE_DIR_PREFIX）
ENTERPRISE_HARNESS_S3_KEY=tmp/vibebiz_prod/vibebiz-harness.zip

# ---- model secret ----
# base64 编码的 32 字节密钥，用于加密 llm_model.api_key_cipher
MODEL_SECRET_KEY=
