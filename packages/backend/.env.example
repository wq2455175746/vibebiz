# ---- processes / ports ----
# Default 127.0.0.1 keeps the unauthenticated CP/DP APIs local-only.
# Docker compose overrides HOST to 0.0.0.0 inside the container network.
HOST=127.0.0.1
CP_PORT=8080
DP_PORT=8081
SANDBOX_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DEBUG=true

# ---- observability ----
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=vibebiz
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=
