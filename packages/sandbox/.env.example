# ---- workspace ----
# Relative to packages/sandbox when running via make dev.
WORKSPACES_DIR=../../data/workspaces
SKILLS_ROOT=../../data/skills
SANDBOX_PORT=8000
# Unique sandbox instance name; defaults to <hostname>:<advertised-port>.
SANDBOX_NAME=
SANDBOX_ADVERTISE_SCHEME=http
SANDBOX_ADVERTISE_HOST=127.0.0.1
SANDBOX_ADVERTISE_PORT=8000
SANDBOX_MAX_CONCURRENCY=8
AGENT_MODE=stub

# ---- CP registry ----
CP_REGISTRY_URL=http://127.0.0.1:8080/cp/api/v1/internal/sandboxes/heartbeat
SANDBOX_REGISTRY_TOKEN=change-me
SANDBOX_HEARTBEAT_INTERVAL=5s

# ---- agent ----
# stub = deterministic harness; claude = official claude-agent-sdk
AGENT_MODE=stub
# DeepSeek Anthropic endpoint; leave empty for Anthropic official API.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# Official Anthropic API key; optional if using LiteLLM auth token.
ANTHROPIC_API_KEY=
# LiteLLM/Anthropic-compatible gateway token.
ANTHROPIC_AUTH_TOKEN=
AGENT_MODEL=deepseek-flash
# all | none | comma-separated skill names
AGENT_SKILLS=all
# comma-separated local plugin directories
AGENT_PLUGINS=
# Maximum single NDJSON message from the Claude Code CLI; image tool results can exceed 1MB.
AGENT_MAX_BUFFER_BYTES=33554432
AGENT_MAX_TURNS=100

# ---- agent sandbox ----
# 总开关；只有同时 AGENT_NETWORK_RESTRICTED=true 才会启用 Bash 沙箱。
AGENT_SANDBOX_ENABLED=true
# 默认 false：允许 Bash 访问外部/本机网络，此时不启用 OS 沙箱（文件工具仍受权限限制）。
# 设为 true 后启用文件+网络沙箱，Bash 无外网，除非 AGENT_SANDBOX_ALLOWED_DOMAINS 放行。
AGENT_NETWORK_RESTRICTED=false
# Docker runs an unprivileged container; bind the existing /proc instead of mounting a new one.
AGENT_SANDBOX_WEAKER_NESTED=true
AGENT_SANDBOX_ALLOWED_DOMAINS=

# ---- controlled web tools ----
# SearXNG-compatible JSON search endpoint, for example http://searxng:8080
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# Comma-separated domains the web_fetch tool may request, for example cdn.jsdelivr.net,fonts.googleapis.com
WEB_FETCH_ALLOWED_DOMAINS=

# ---- legacy LLM stub settings (used when AGENT_MODE=llm) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash

# ---- observability ----
LOG_LEVEL=info
# 日志目录；留空只输出 stdout。容器内使用 /app/logs
LOG_DIR=
OTEL_SERVICE_NAME=vibebiz-sandbox
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=vibebiz
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=

# ---- clone capability ----
# 默认关闭；开启会在 sandbox 容器内直接执行仓库测试代码
CLONE_TEST_RUNNER_ENABLED=false
CLONE_TEST_TIMEOUT_SECONDS=120
