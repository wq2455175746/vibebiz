# Published share pages must be served through CP so that /p/:slug PV and
# track/click are recorded. The nginx image renders this template with envsubst;
# CP_UPSTREAM is set per compose file (local backend:8080, public backend:18080).
server {
    listen 80;
    server_name _;

    location /p/ {
        proxy_pass http://${CP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
