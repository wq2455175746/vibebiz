<script setup lang="ts">
const props = defineProps<{ title: string; value: string }>()
const emit = defineEmits<{ select: [value: string] }>()

function select() {
  emit('select', props.value)
}
</script>

<template>
  <button class="card" type="button" @click="select">
    <strong>{{ title }}</strong>
    <span>{{ value }}</span>
  </button>
</template>

